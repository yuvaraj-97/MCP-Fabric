{
  "name": "mcp-fabric",
  "version": "0.0.0",
  "private": true,
  "description": "Session-aware, transport-agnostic infrastructure for MCP-compatible deployments.",
  "type": "module",
  "scripts": {
    "test": "node tests/run-tests.js",
    "test:unit": "node tests/run-tests.js",
    "test:integration": "node --test tests/transport-agnostic/stdio-http-parity.test.js tests/failover/http-sse-gateway.test.js",
    "demo": "node apps/local-dashboard/server.js",
    "demo:stdio": "node examples/stdio-server/server.js",
    "demo:http": "node examples/http-sse-server/server.js",
    "demo:multi": "node examples/multi-server-load-balanced-demo/server.js",
    "demo:load:local": "node examples/multi-server-load-balanced-demo/load-generator.js http://127.0.0.1:3001 25 100",
    "validate:filesystem": "node validation/filesystem/run-validation.js",
    "validate:filesystem:multicontainer": "node validation/multicontainer/run-filesystem-proof.js",
    "validate:filesystem:conversation": "node validation/filesystem/run-conversation.js",
    "validate:filesystem:openai": "node validation/filesystem/run-openai-conversation.js",
    "validate:git": "node validation/git/run-validation.js",
    "validate:git:multicontainer": "node validation/git/run-multicontainer-proof.js",
    "validate:memory": "node validation/memory/run-validation.js",
    "validate:memory:multicontainer": "node validation/memory/run-multicontainer-proof.js",
    "validate:adaptive-placement": "node validation/adaptive-placement/run-validation.js",
    "validate:shared-redis": "node validation/shared-redis/run-proof.js",
    "validate:burst-memory": "node --expose-gc validation/burst-memory/run-proof.js",
    "check": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ioredis": "^5.10.1",
    "zod": "^4.4.3"
  }
}
